# fd-strapi 生产环境变量模板（节点侧）。
# 复制为 deploy/.env 后逐项填写；compose 同时用本文件做变量插值
# （${FD_STRAPI_IMAGE}、postgres 的库名/账号等）与 strapi 容器的 env_file。
#
# 秘钥生成：openssl rand -base64 32
# APP_KEYS 是例外：逗号分隔恰好四个（Strapi 用轮换密钥组）。

# ---- compose 插值（不进 strapi 进程也无所谓，env_file 会带上） ----
# 构建池出片的镜像引用（如 registry.example.com/fd/fd-strapi:20261016-a1b2c3）
FD_STRAPI_IMAGE=
# 端口发布形态：默认仅绑回环（节点上反代转发）；见 compose.yml 注释
FD_STRAPI_BIND=127.0.0.1
FD_STRAPI_PORT=1337

# ---- server ----
HOST=0.0.0.0
PORT=1337
# 对外根地址（绝对链接/CORS 用）；本地开发不设
PUBLIC_URL=https://cms.finddatatech.cloud

# ---- database（compose 内 postgres 服务） ----
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USER=strapi
DATABASE_PASSWORD=          # openssl rand -base64 32（与下面 postgres 初始化共用，compose 插值给 POSTGRES_PASSWORD）
DATABASE_SSL=false
# 连接池（config/database.ts 默认 min=0 / max=5，适配 512m 内存上限；可不设）
#DATABASE_POOL_MIN=0
#DATABASE_POOL_MAX=5

# ---- 发布守卫规则清单（RULES.md） ----
# 守卫默认按容器内 <cwd>/src/rules/internal-identifiers.txt 解析，与 compose 的
# 只读挂载路径一致；显式写出来防漂移。改路径要同步改 compose.yml 挂载目标。
FD_RULES_FILE=/app/src/rules/internal-identifiers.txt

# ---- 秘钥（全部 openssl rand -base64 32；不要用示例值） ----
# 四个、逗号分隔、无空格
APP_KEYS=<k1>,<k2>,<k3>,<k4>
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
# users-permissions 插件的 JWT（研究员经 /api 登录时的会话签名）
JWT_SECRET=
# 内容传输（import/export）token 盐
TRANSFER_TOKEN_SALT=
# API token 存储加密密钥
ENCRYPTION_KEY=

# ---- i18n ----
# 空库初始化的首个 locale（同时成为默认 locale）。启动时 bootstrap 的
# ensureLocales() 会幂等补齐 zh/en 并把默认设为 zh。
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=zh

# ---- 不要设置（仅本地开发用） ----
# DEV_SEED=1         会给 public 角色开读权限 + 种样例内容，生产禁止
# MIGRATE_CONTENT=1  一次性内容导入用 docker compose run 显式传，不常驻

# strapi-plugin-sso（Logto admin 租户 cms-console 应用）
SSO_OIDC_CLIENT_ID=03pozpxtfqj1k5v0296j1
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_REDIRECT_URI=https://cms.finddatatech.cloud/strapi-plugin-sso/oidc/callback

# 雷池（SafeLine）控制台——运维入口凭据，勿提交真实值
SAFELINE_CONSOLE=https://<edge-host>:9443
SAFELINE_ADMIN_USER=admin
SAFELINE_ADMIN_PASSWORD=

# webhook 监听地址。默认 127.0.0.1（只本机）；容器要打进来时必须显式设为
# 该节点的私有网络地址。生产值不随仓保存。
WEBHOOK_BIND_HOST=127.0.0.1
WEBHOOK_BIND_PORT=8125
