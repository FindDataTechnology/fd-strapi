{
  "kind": "collectionType",
  "collectionName": "research_articles",
  "info": {
    "singularName": "research-article",
    "pluralName": "research-articles",
    "displayName": "研究 Research Article",
    "description": "星研研究长文（官网集合目录为 research）。正文为 markdown 源文本（design.md D3）。字段对齐 fd-official-web src/content.config.ts 的 research zod schema（含必填枚举 kind）。"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true,
      "minLength": 1,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "date": {
      "type": "date",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "paper",
        "casestudy",
        "note"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "tags": {
      "type": "json",
      "default": [],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sources": {
      "type": "json",
      "default": [],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "claims": {
      "type": "json",
      "default": [],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "body": {
      "type": "richtext",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
