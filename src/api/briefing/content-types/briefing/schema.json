{
  "kind": "collectionType",
  "collectionName": "briefings",
  "info": {
    "singularName": "briefing",
    "pluralName": "briefings",
    "displayName": "内参 Briefing",
    "description": "星研内参：事件驱动单篇。正文为 markdown 源文本（design.md D3）。字段对齐 fd-official-web src/content.config.ts 的 briefings zod schema。"
